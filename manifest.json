{
  "manifest_version": 3,
  "name": "清大校務與全網通用驗證碼自動填入 (NTHU & Universal Captcha AutoFill)",
  "version": "1.2.2",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "description": "精準自動辨識並填入清華大學校務系統(CCXP)、OAuth，以及支援全網常見英數字登入驗證碼。純本機離線神經網路，零額外連線，靜默自動填入。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "*://www.ccxp.nthu.edu.tw/*",
    "*://ccxp.nthu.edu.tw/*",
    "*://oauth.ccxp.nthu.edu.tw/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.ccxp.nthu.edu.tw/ccxp/INQUIRE/*",
        "*://ccxp.nthu.edu.tw/ccxp/INQUIRE/*"
      ],
      "js": [
        "decaptcha.model.js",
        "decaptcha.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://oauth.ccxp.nthu.edu.tw/*"
      ],
      "js": [
        "oauth.decaptcha.model.js",
        "oauth.decaptcha.js",
        "oauth.content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.ccxp.nthu.edu.tw/*"
      ],
      "js": [
        "detector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "libs/*",
        "offscreen.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
